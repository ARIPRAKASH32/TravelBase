# ==============================================================================
# TravelBase - Environment Variables Template
# Copy this file to .env or backend/.env and replace placeholders with your own secrets.
# NEVER commit .env or any file containing actual API keys or credentials to Git.
# ==============================================================================

# Flask Session & CSRF Secret Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your_secure_flask_secret_key_here

# Database Connection URL (MySQL with PyMySQL)
# Example: mysql+pymysql://<user>:<password>@localhost:3306/<dbname>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://travelbase_user:your_db_password_here@localhost:3306/travelbase_db?charset=utf8mb4

# Session Cookie Security (set to true in production over HTTPS)
SESSION_COOKIE_SECURE=false

# Third-party APIs (TravelBase Integrations - Keep Private)
# MAPS_API_KEY=your_google_or_mapbox_api_key_here
# WEATHER_API_KEY=your_openweather_api_key_here
# PAYMENT_GATEWAY_KEY=your_stripe_or_razorpay_key_here
